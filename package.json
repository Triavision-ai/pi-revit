{
  "name": "pi-revit",
  "version": "0.5.2",
  "description": "Native Pi connector for Autodesk Revit. Run npx.cmd -y pi-revit for the full Windows install.",
  "author": "Ahmad Altahlawi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Triavision-ai/pi-revit.git"
  },
  "bugs": {
    "url": "https://github.com/Triavision-ai/pi-revit/issues"
  },
  "homepage": "https://github.com/Triavision-ai/pi-revit#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "revit",
    "bim",
    "autodesk",
    "revit-api"
  ],
  "bin": {
    "pi-revit": "bin/pi-revit.js"
  },
  "scripts": {
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-workspace.ps1",
    "uninstall:revit": "powershell -ExecutionPolicy Bypass -File scripts/uninstall.ps1"
  },
  "files": [
    "bin/pi-revit.js",
    "extensions/pi-revit/*.ts",
    "skills/pi-revit/SKILL.md",
    "skills/pi-revit/tool-manifest.json",
    "skills/pi-revit/contracts.generated.json",
    "skills/pi-revit/references/**/*.md",
    "scripts/build.ps1",
    "scripts/check-sdk.ps1",
    "scripts/deploy.ps1",
    "scripts/setup-workspace.ps1",
    "scripts/uninstall.ps1",
    "scripts/revit.ps1",
    "src/Revit/*.cs",
    "src/Revit/Tools/*.cs",
    "src/Revit/RevitBridge.csproj",
    "src/Revit/RevitBridge.addin",
    "workspace/AGENTS.md",
    "workspace/*.cmd",
    "docs/architecture.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-revit/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=20.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
