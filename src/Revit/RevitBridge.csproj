<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows -> Revit 2025/2026; net10.0-windows -> Revit 2027. The build picks
         per-TFM defaults below; deploy.ps1 builds the single TFM that matches its -RevitVersion. -->
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RevitBridge</AssemblyName>
    <RootNamespace>RevitBridge</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <!-- MSB3277: harmless version-conflict noise from RevitAPIUI transitive deps; nothing is copied local. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!-- RevitAPI.dll location, defaulted per target framework. Override either target with:
       dotnet build -p:TargetFramework=net10.0-windows -p:RevitApiPath="D:\Autodesk\Revit 2027" -->
  <PropertyGroup Condition="'$(RevitApiPath)' == '' and '$(TargetFramework)' == 'net10.0-windows'">
    <RevitApiPath>C:\Program Files\Autodesk\Revit 2027</RevitApiPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitApiPath)' == ''">
    <RevitApiPath>C:\Program Files\Autodesk\Revit 2025</RevitApiPath>
  </PropertyGroup>

  <!-- Revit API assemblies are provided by Revit at runtime; never copy them local. -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiPath)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiPath)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- execute_csharp compiles scripts with Roslyn, but this assembly must never reference
       Roslyn: Revit loads all add-ins into one shared context, where another add-in's Roslyn
       version would be mixed in. Roslyn lives in RevitBridge.ScriptCompiler, which the add-in
       loads into a private AssemblyLoadContext (ScriptCompilerHost.cs).

       The reference below only orders the build and restore: no assembly and no NuGet asset
       flows into this project, so Roslyn types cannot be used here by accident. -->
  <ItemGroup>
    <ProjectReference Include="..\Revit.ScriptCompiler\RevitBridge.ScriptCompiler.csproj"
                      ReferenceOutputAssembly="false"
                      ExcludeAssets="all"
                      Private="false" />
  </ItemGroup>

  <!-- Ship the compiler and its Roslyn closure in the compiler\ subfolder of the build output;
       scripts/deploy.ps1 copies the whole output into the add-in folder. -->
  <Target Name="CopyScriptCompiler" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <ItemGroup>
      <_ScriptCompilerOutput Include="$(MSBuildThisFileDirectory)..\Revit.ScriptCompiler\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <_ScriptCompilerOutput Include="$(MSBuildThisFileDirectory)..\Revit.ScriptCompiler\bin\$(Configuration)\$(TargetFramework)\*.pdb" />
    </ItemGroup>
    <Error Condition="'@(_ScriptCompilerOutput)' == ''" Text="RevitBridge.ScriptCompiler was not built for $(TargetFramework); execute_csharp would not work." />
    <RemoveDir Directories="$(OutDir)compiler" />
    <Copy SourceFiles="@(_ScriptCompilerOutput)" DestinationFolder="$(OutDir)compiler" />
  </Target>

</Project>
